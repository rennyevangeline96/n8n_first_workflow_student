    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return ONLY a JSON object.\n\nRow data: {{ JSON.stringify($json) }}\n\nRules:\n- Name: Title Case (Manoj K)\n- Email: if invalid set INVALID_EMAIL\n- Phone: if less than 10 digits set MISSING\n- Course: only Python or Machine Learning or Data Science\n- Fee_Paid: yes/YES = true, no/NO = false\n- City: Title Case, empty = UNKNOWN\n- Enrolled_Date: convert to YYYY-MM-DD\n\nReturn ONLY raw JSON. No explanation. No markdown.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -400,
        -208
      ],
      "id": "c8b0b665-1f39-4789-9d55-0326d1d7e416",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -368,
        -16
      ],
      "id": "a255fb15-7150-44e1-b8e1-497619521eba",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "SjhbYGjKz0QG9Niy",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // 1. Locate the AI raw output string (checks common AI response keys)\n  let rawContent = item.json.text || item.json.response || item.json.output || item.json.content || item.json;\n\n  let parsed = {};\n\n  if (typeof rawContent === 'string') {\n    // Clean potential markdown blocks or escaping\n    let cleaned = rawContent\n      .replace(/```json/gi, '')\n      .replace(/```/g, '')\n      .trim();\n\n    try {\n      parsed = JSON.parse(cleaned);\n    } catch (err) {\n      // Fallback: handle literal escaped newlines or quotes if double-encoded\n      try {\n        parsed = JSON.parse(JSON.parse(`\"${cleaned}\"`));\n      } catch (e) {\n        parsed = { error: 'Failed to parse JSON', raw: rawContent };\n      }\n    }\n  } else if (typeof rawContent === 'object' && rawContent !== null) {\n    parsed = rawContent;\n  }\n\n  // 2. Validate and standardize Enrolled_Date to YYYY-MM-DD\n  if (parsed.Enrolled_Date) {\n    const dateObj = new Date(parsed.Enrolled_Date);\n    if (!isNaN(dateObj.getTime())) {\n      parsed.Enrolled_Date = dateObj.toISOString().split('T')[0];\n    }\n  }\n\n  return { json: parsed };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
